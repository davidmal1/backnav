__pycache__/
*.pyc
# No trailing slash, deliberately. A trailing slash matches directories
# only, and in a linked worktree this path is a SYMLINK to the main
# worktree's certs dir (one source of truth for the private key), which
# such a rule does not match - leaving it showing as untracked and
# stageable by `git add -A`. Without the slash both forms are ignored.
backnav-engine/certs

# The chromium extension's signing key. Only the PUBLIC half belongs in
# git, and it already is - it is the "key" field in
# browser/chromium/manifest.json, which is what pins the extension id.
# The private half is only needed to sign a .crx with a matching id, and
# is kept purely so that option stays open.
#
# Deliberately OUTSIDE browser/chromium/: that whole directory is what
# gets loaded as the extension and zipped for submission, so a key stored
# in it would ship to the store and to every user.
browser/.keys

# Build artifacts - produced by browser/build-xpi.sh on demand.
browser/*.xpi

# Working notes - kept locally, not part of what is published. The file
# still exists in this checkout and in history up to 801ad9c; this only
# stops future versions being committed.
TODO.md
