{
  "manifest_version": 3,
  "name": "BackNav for Thunderbird",
  "version": "0.1",
  "description": "Reports Thunderbird tab activity to the BackNav navigation daemon, so BackNav's back/forward shortcuts can restore a specific mail tab or message tab.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "backnav@davidmal1.github.io",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "tabs",
    "storage",
    "alarms"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  }
}
