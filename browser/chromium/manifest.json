{
  "manifest_version": 3,
  "name": "BackNav",
  "version": "0.1",
  "key": "",
  "description": "Provides BackNav with active browser tab information.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "tabs",
    "storage",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
