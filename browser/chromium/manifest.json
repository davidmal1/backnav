{
  "manifest_version": 3,
  "name": "BackNav",
  "version": "0.1",
  "key": "",
  "description": "Provides BackNav with active browser tab information.",
  "permissions": [
    "tabs",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
