{
  "manifest_version": 3,
  "name": "BackNav",
  "version": "0.1",

  "description": "Provides BackNav with active browser tab information.",

  "permissions": [
    "tabs",
    "storage"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "background": {
    "service_worker": "background.js"
  }
}
